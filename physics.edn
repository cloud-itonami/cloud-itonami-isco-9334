;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a shelf-restocking and inventory-scanning robot
;; performs shelf restocking, price-tag verification and out-of-stock
;; flagging in a retail store (ISCO 9334). Its physical work: an arm on a
;; mast placing restock items onto the top shelf, and pushing the loaded
;; restock cart down the aisle, where an emergency stop must not tip it.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-9334"
 :cases
 [{:id :item-to-top-shelf
   :kind :manipulator
   :procedure "mast-mounted arm lifts a restock item (or case) from the cart to the front of the top shelf"
   :params {:l1-m 0.55 :l2-m 0.50 :m1-kg 4.5 :m2-kg 3.0
            :from [0.45 0.05] :to [0.60 0.80] :duration-s 2.0 :steps 400}
   :sweep {:param :payload-kg :values [0.5 1.0 2.0 4.0 6.0 8.0]}
   :quantity :peak-tau1-nm
   :limit {:max 70.0 :basis "estimate: continuous shoulder torque of a ~5 kg-payload collaborative arm"}
   :boundary {:lo 0.1 :hi 20.0}}
  {:id :restock-cart-e-stop
   :kind :transport
   :procedure "robot pushes a loaded restock cart 30 m down the aisle and makes an emergency stop at 2 m/s2 when a shopper steps out; load varied"
   :params {:mass-kg 80.0 :distance-m 30.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 2.0 :drive-force-n 300.0 :crr 0.015
            :cog-height-m 0.30 :support-half-length-m 0.25 :payload-cog-height-m 1.10
            :max-time-s 600.0}
   :sweep {:param :payload-kg :values [20.0 50.0 100.0 150.0 200.0]}
   :quantity :min-tipover-margin
   :limit {:min 0.3 :basis "estimate: keep 30% static-stability margin at emergency-stop deceleration among shoppers"}
   :boundary {:lo 5.0 :hi 400.0}}]}
